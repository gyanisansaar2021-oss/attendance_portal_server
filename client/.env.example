# Attendance Portal — client environment configuration
#
# Copy this file to `.env` and adjust as needed. Expo automatically loads
# `.env` and inlines EXPO_PUBLIC_* variables at build time.
#
# Switching between the mock Express API and the Java Spring Boot API is ONLY
# a change to this URL — no source code changes required.

# --- Local development on an emulator / simulator / web ---
# Android emulator: use 10.0.2.2 to reach your machine's localhost.
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1
# iOS simulator / web:
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Physical phone (Expo Go / dev build) ---
# `localhost` on a phone points to the PHONE itself, not your computer.
# Use your development machine's LAN IP instead (find it with `ipconfig` on
# Windows / `ifconfig` on macOS/Linux). The phone and computer must be on the
# same Wi-Fi network.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1

# --- Later: Java Spring Boot backend ---
# Point to the real backend; nothing else in the client changes.
#   EXPO_PUBLIC_API_BASE_URL=https://api.yourschool.com/api/v1
